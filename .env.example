# Modèle de configuration. Copiez-le en .env.local (développement)
# ou recopiez chaque ligne dans Vercel → Settings → Environment Variables.

# ── Supabase (obligatoire) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ── Identité du club ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mon-club.vercel.app
NEXT_PUBLIC_CLUB_NAME=Aéroclub de Mon Terrain
# Terrain de base : code OACI + nom affiché (météo, quiz, page d'accueil)
NEXT_PUBLIC_HOME_ICAO=LFXX
NEXT_PUBLIC_HOME_AIRFIELD=Mon Terrain

# ── Météo / NOTAM (codes OACI séparés par des virgules) ────────────────
# QNH : la première station qui publie un METAR est utilisée
QNH_STATIONS=LFXX,LFYY
TAF_STATIONS=LFXX,LFYY
NOTAM_LOCATIONS=LFXX,LFYY

# ── Emails (une des deux solutions, facultatif) ────────────────────────
# Solution A : SMTP (Gmail par défaut : mot de passe d'application Google)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Solution B : Resend
RESEND_API_KEY=
# Expéditeur, ex. "Aéroclub <sorties@mon-club.fr>"
EMAIL_FROM=

# ── Sauvegarde des fichiers (scripts/ et GitHub Actions UNIQUEMENT) ────
# Ne JAMAIS mettre ces deux valeurs dans Vercel ni dans un fichier commité.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
